# Modèle de configuration locale de MA Core.
# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# Ne jamais mettre de vrai mot de passe ou de vraie clé dans ce fichier modèle.

# --- Base MA ---
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# --- Authentification ---
# true = le code 2FA 000000 est accepté (LOCAL UNIQUEMENT, jamais en production)
MA_AUTH_DEMO_TOTP=true
# MA_AUTH_RSA_KEYSTORE=./data/rsa.jwk
# MA_AES_KEY=
# MA_INTERNAL_API_KEY=

# --- E-mail (SMTP) ---
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FRONTEND_BASE_URL=http://localhost:5173
MAIL_TEST_TO=

# --- Assistant IA (Groq) ---
# Une ligne GROQ_API_KEY= sans valeur = assistant non configuré.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Colis na Nga : lecture seule (voir docs/INTEGRATION-COLIS-NA-NGA.md) ---
# Nécessite : cloud-sql-proxy --port 3310 colis-na-ngai:europe-west1:colis-db
MA_CNN_MODE=db
MA_CNN_DB_URL=jdbc:mysql://127.0.0.1:3310/colisnanga?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Africa/Kinshasa
MA_CNN_DB_USERNAME=ma_reader
MA_CNN_DB_PASSWORD=
# MA_CNN_CACHE_SECONDS=10
# MA_CNN_STORAGE_ZONE=UTC

# --- Colis na Nga : relais d'administration ---
# MA_CNN_API_BASE_URL=https://colis-backend-378771858294.europe-west1.run.app
# MA_CNN_API_TIMEOUT_SECONDS=20
