MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FRONTEND_BASE_URL=http://localhost:5173
MAIL_TEST_TO=
# Copier vers .env (jamais commité). Même fichier que le SMTP.
# GROQ_API_KEY doit être non vide — une ligne GROQ_API_KEY= sans valeur = assistant non configuré.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
